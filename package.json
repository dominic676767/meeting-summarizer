{
  "name": "meeting-summarizer",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium extension: record Teams web meeting audio, transcribe it, summarize with your LLM of choice, save as local HTML.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node eval/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@smithy/signature-v4": "^5.7.4"
  }
}
