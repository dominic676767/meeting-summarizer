{
  "manifest_version": 3,
  "name": "Meeting Summarizer",
  "version": "0.1.1",
  "description": "Captures live captions from Teams web meetings, summarizes them with your LLM of choice, and saves a local HTML summary to Downloads.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.microsoft.com/*"
      ],
      "js": ["teams-content.js", "capture-prompt.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Start recording the current meeting"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Summarizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabCapture",
    "audioCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.elevenlabs.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.amazonaws.com/*"
  ]
}
