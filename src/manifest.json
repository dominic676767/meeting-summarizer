{
  "manifest_version": 3,
  "name": "Meeting Summarizer",
  "version": "0.1.1",
  "description": "Captures live captions from Teams web meetings, summarizes them with your LLM of choice, and saves a local HTML summary to Downloads.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.microsoft.com/*"
      ],
      "js": ["teams-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Summarizer",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.amazonaws.com/*"
  ]
}
